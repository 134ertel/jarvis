# Copy this file to .env (in this same backend/ folder) if you want to
# override where JARVIS looks for its local AI. Both are optional — the
# defaults below already match a normal Ollama install (https://ollama.com),
# and JARVIS works with no .env file at all.
#
# JARVIS uses Ollama for full natural-language understanding, entirely for
# free and fully locally — no API key, no account, no cloud model. Install
# Ollama, pull a tool-calling-capable model (e.g. `ollama pull llama3.1:8b`),
# and make sure `ollama serve` is running. Without it, JARVIS still opens
# normally and shows "Offline" / "Local AI not connected." in Settings,
# falling back to simple pattern-matched command responses — see
# app/ai/responder.py and app/ai/manager.py.
OLLAMA_HOST=http://localhost:11434

# Which model to use is normally changed from Settings (the picker there
# reads the models Ollama already has pulled) — this only sets the initial
# default the very first time, before any model has ever been chosen there.
OLLAMA_MODEL=llama3.1:8b
